{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "radical-socials/feed-author-avatar",
	"title": "Feed Author Avatar",
	"category": "theme",
	"description": "Displays the avatar of a feed item's author (e.g. ActivityPub actor).",
	"textdomain": "radical-socials",
	"render": "file:./render.php",
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"usesContext": [ "postId" ],
	"attributes": {
		"isLink":  { "type": "boolean", "default": true },
		"rounded": { "type": "boolean", "default": true },
		"width":   { "type": "string",  "default": "48px" }
	},
	"supports": {
		"html": false,
		"interactivity": { "clientNavigation": true },
		"spacing": {
			"margin": true,
			"padding": true,
			"defaultControls": { "margin": false, "padding": false }
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true,
			"__experimentalDefaultControls": { "radius": true }
		}
	}
}
