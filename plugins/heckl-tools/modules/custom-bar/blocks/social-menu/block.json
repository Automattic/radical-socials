{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "heckl/social-menu",
	"title": "Social Menu",
	"category": "widgets",
	"description": "A styleable list of the same links shown in the Heckl Tools bar.",
	"textdomain": "heckl-tools",
	"editorScript": "file:./editor.js",
	"style": [ "dashicons", "file:./style.css" ],
	"supports": {
		"html": false,
		"interactivity": {
			"clientNavigation": true
		},
		"layout": {
			"default": { "type": "flex", "orientation": "vertical" }
		},
		"color": {
			"text": true,
			"link": true,
			"defaultControls": { "text": true, "link": true }
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"defaultControls": { "blockGap": true }
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"defaultControls": { "fontSize": true }
		}
	}
}
