{
	"apiVersion": 3,
	"name": "heckl/favorite-feeds",
	"title": "Favorite Feeds",
	"category": "widgets",
	"description": "A list of your starred feed subscriptions.",
	"textdomain": "heckl-tools",
	"editorScript": "file:./editor.js",
	"style": "wp-block-categories",
	"supports": {
		"html": false,
		"interactivity": {
			"clientNavigation": true
		},
		"layout": {},
		"color": {
			"gradients": true,
			"link": true,
			"defaultControls": { "background": true, "text": true, "link": true }
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"defaultControls": { "margin": false, "padding": false, "blockGap": false }
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"defaultControls": { "fontSize": true }
		}
	}
}
