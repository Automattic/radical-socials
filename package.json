{
  "name": "heckl",
  "version": "1.0.0",
  "description": "Escape closed-wall social media platforms with a self-hosted WordPress alternative.",
  "private": true,
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=plugins/heckl-tools/src --output-path=plugins/heckl-tools/build",
    "start": "wp-scripts start --webpack-src-dir=plugins/heckl-tools/src --output-path=plugins/heckl-tools/build",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "env:destroy": "wp-env destroy",
    "env:logs": "wp-env logs",
    "env:run": "wp-env run cli wp",
    "env:reset": "wp-env clean all && wp-env start",
    "playground:start": "wp-playground-cli server --mount=./plugins/heckl-tools:/wordpress/wp-content/plugins/heckl-tools --mount=./themes/heckl:/wordpress/wp-content/themes/heckl --port=8890 --blueprint=./playground-blueprint.json",
    "env:cron": "curl -s 'http://localhost:8890/wp-cron.php?doing_wp_cron' > /dev/null",
    "test": "wp-scripts test-unit-js",
    "test:integration": "wp-env run cli wp heckl integration-tests",
    "build:templates": "php ./bin/build-templates.php",
    "plugin-zip": "bash ./bin/build-plugin-zip.sh",
    "theme-zip": "bash ./bin/build-theme-zip.sh",
    "release:plugin": "bash ./bin/release.sh plugin",
    "release:theme": "bash ./bin/release.sh theme"
  },
  "engines": {
    "npm": "10.x"
  },
  "dependencies": {
    "@wordpress/icons": "^10.32.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@wordpress/env": "^10.14.0",
    "@wordpress/scripts": "^30.8.0",
    "@wp-playground/cli": "^3.1.21"
  }
}
