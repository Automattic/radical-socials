{
  "name": "radical-socials",
  "version": "0.1.0",
  "description": "Escape closed-wall social media platforms with a self-hosted WordPress alternative.",
  "private": true,
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=plugins/radical-socials/src --output-path=plugins/radical-socials/build",
    "start": "wp-scripts start --webpack-src-dir=plugins/radical-socials/src --output-path=plugins/radical-socials/build",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "env:destroy": "wp-env destroy",
    "env:logs": "wp-env logs",
    "env:run": "wp-env run cli wp",
    "env:reset": "wp-env clean all && wp-env start",
    "playground:start": "wp-playground-cli server --mount=./plugins/radical-socials:/wordpress/wp-content/plugins/radical-socials --mount=./themes/radical-theme:/wordpress/wp-content/themes/radical-theme --port=8890 --blueprint=./playground-blueprint.json",
    "test": "wp-scripts test-unit-js"
  },
  "dependencies": {
    "@wordpress/icons": "^10.24.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@wordpress/env": "^10.14.0",
    "@wordpress/scripts": "^30.8.0",
    "@wp-playground/cli": "^3.1.21"
  }
}
