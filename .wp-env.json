{
  "core": "https://wordpress.org/wordpress-7.0.zip",
  "phpVersion": "8.2",
  "port": 8890,
  "testsPort": 8891,
  "plugins": [
    "./plugins/heckl-tools",
    "https://downloads.wordpress.org/plugin/query-monitor.latest-stable.zip",
    "https://downloads.wordpress.org/plugin/activitypub.latest-stable.zip"
  ],
  "themes": [
    "./themes/heckl"
  ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local",
    "SAVEQUERIES": true
  },
  "mappings": {},
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp theme activate heckl"
  }
}
