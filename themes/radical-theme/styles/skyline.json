{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Skyline",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#f5fbff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#536575",
					"name": "Contrast 1",
					"slug": "contrast-1"
				},
				{
					"color": "#071826",
					"name": "Contrast 2",
					"slug": "contrast-2"
				},
				{
					"color": "#c9e8ff",
					"name": "Contrast 3",
					"slug": "contrast-3"
				},
				{
					"color": "#1285ff",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#43c7f4",
					"name": "Accent 2",
					"slug": "accent-2"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/navigation-link": {
				"color": {
					"text": "var(--wp--preset--color--contrast-2)"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--contrast-1)"
				}
			},
			"core/post-terms": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			},
			"core/read-more": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			},
			"core/search": {
				"css": "& .wp-block-search__input{background:#fff;border-color:var(--wp--preset--color--contrast-3);color:var(--wp--preset--color--contrast-2);} & .wp-block-search__button{background:var(--wp--preset--color--accent);border-color:var(--wp--preset--color--accent);color:#fff;}"
			},
			"core/separator": {
				"border": {
					"color": "var(--wp--preset--color--contrast-3)"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast-1)"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast-2)"
				},
				"typography": {
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		}
	}
}
